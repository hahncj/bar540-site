{
  "name": "bar540-site",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "secrets_store_secrets": [
    {
      "binding": "ALLOWED_EMAILS",
      "store_id": "d7e39048e9b14ecbac44deb7b163e132",
      "secret_name": "allowed-emails"
    },
    {
      "binding": "SESSION_SECRET",
      "store_id": "d7e39048e9b14ecbac44deb7b163e132",
      "secret_name": "session-secret"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bar540",
      "database_id": "ec39959b-6018-4b76-99af-dc03e9ebda5c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bar540-photos"
    }
  ],
  // Public OAuth client ID from Google Cloud Console (not a secret).
  // ALLOWED_EMAILS and SESSION_SECRET come from the Secrets Store bindings above.
  "vars": {
    "GOOGLE_CLIENT_ID": "699811359194-oe61glrsh1kjas73lihil1d3s1fbdldp.apps.googleusercontent.com"
  }
}
