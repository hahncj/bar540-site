{
  "name": "bar540-site",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bar540",
      "database_id": "ec39959b-6018-4b76-99af-dc03e9ebda5c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bar540-photos"
    }
  ]
}
